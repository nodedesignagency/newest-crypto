# Copy to .env and fill in. Expo exposes EXPO_PUBLIC_* to the app at build time.
# .env is gitignored — never commit a real key.

# Optional. Free Demo key from coingecko.com -> Developer Dashboard (no card required).
# Without it the app still works, just at a lower rate limit.
EXPO_PUBLIC_COINGECKO_KEY=

# Set to 1 to use bundled mock data instead of the live API.
# Useful offline, and required in sandboxes that block api.coingecko.com.
EXPO_PUBLIC_USE_MOCK=
